# ---- Local development (SQLite): only these two matter ----
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-only

# ---- Production (copy to .env on the server and fill in) ----
# DJANGO_DEBUG=0
# DJANGO_SECRET_KEY=paste-a-long-random-string-here
# DOMAIN=www.example.ph
# DJANGO_ALLOWED_HOSTS=www.example.ph,example.ph
# DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.ph,https://example.ph
# POSTGRES_DB=soemco
# POSTGRES_USER=soemco
# POSTGRES_PASSWORD=paste-another-long-random-string
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

